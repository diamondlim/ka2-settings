<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hermes.ka2settings"
    android:versionCode="65"
    android:versionName="7.15">
  <!-- The app updates itself from its own GitHub releases: the APK is downloaded, then handed to the
       system package installer as a content:// URI. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <!-- The drive log is fetched from the host archive over HTTPS; Bluetooth stays for settings. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.BLUETOOTH"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
      android:usesPermissionFlags="neverForLocation"/>
  <!-- NOT for recording a track any more: the app no longer does that (the box logs its own GPS and the
       host extracts it). It stays because Android 11 and below require location for Bluetooth DISCOVERY,
       and BtSpp still discovers the box when no address is saved - missingBluetoothPermissions() asks for
       this before connecting on those versions, so removing it would break the Bluetooth link on the unit. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <!-- What the app is allowed to SEE: on Android 11+ (enforced for anything targeting 30+) an app can
       only see packages it declares here, and queryIntentActivities() silently returns an empty list for
       the rest. Without this the installer probe in Update.hasApkInstaller() reports "no APK installer"
       on phones that have one, and the app refuses to update itself. It asks about the package-archive
       VIEW intent because that is exactly what the handoff uses. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <data android:mimeType="application/vnd.android.package-archive"/>
    </intent>
  </queries>
  <application android:label="KA2 Settings" android:icon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:networkSecurityConfig="@xml/network_security_config"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".SettingsActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <!-- Hands the downloaded update APK to the package installer as a content:// URI; not exported,
         the receiving installer gets a one-shot read grant with the intent. -->
    <provider android:name=".ApkProvider"
        android:authorities="com.hermes.ka2settings.apk"
        android:exported="false"
        android:grantUriPermissions="true"/>
  </application>
</manifest>
